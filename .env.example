# Generate a token: npm run generate-token
LAUNCHER_TOKEN=your-secret-token-here

# Port to listen on (default 3777)
PORT=3777

# Allowed working directories (comma-separated prefixes)
ALLOWED_DIRS=/path/to/your/projects

# Max concurrent sessions
MAX_SESSIONS=3

# Session TTL in hours (default 24, set 0 to disable the hard cap entirely)
# SESSION_TTL_HOURS=24

# Minutes of no-stdout before an alive session is marked "stale" (default 15)
# STALE_THRESHOLD_MIN=15

# Tailnet domain suffix (e.g. tail954375.ts.net) — used in dev server UI hints
# TAILNET_DOMAIN=your-tailnet.ts.net
